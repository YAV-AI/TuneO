# TuneO configuration. Copy to .env and fill in your keys:
#   cp .env.example .env
# Never commit .env: it contains your secrets.

# Required. Music generation through KIE AI. Create a key at https://kie.ai/api-key
KIE_API_KEY=

# Optional. Enables the lyric writer (Advanced mode) and the magic wand (Simple mode).
OPENAI_KEY=
# Optional. Model for lyric and prompt writing (default gpt-5.5).
OPENAI_MODEL=
# Optional. none | low | medium | high (default low). Higher is slower but more polished.
OPENAI_REASONING=

# Storage (RustFS, S3 compatible). Change both before the first start; the defaults are public.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# Optional. Bucket name (default tuneo).
S3_BUCKET=

# Optional. Host ports, bound to 127.0.0.1 only (defaults 3000, 9000, 9001).
WEB_PORT=
RUSTFS_PORT=
RUSTFS_CONSOLE_PORT=
